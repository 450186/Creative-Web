<%- include('../partials/header') %>
    <div style="margin-top: 40px;" class="ContentBody">
        <h4>New post</h4>
        <form action="/newpost" method="POST">
            <label>message</label>
            <input type="text" id="message" name="message">
            <input type="submit" value="post message">
        </form>
        <h4>Recent posts</h4>
        <p id="recent-posts"></p>
        <% if (typeof errorMessage !== 'undefined') { %>
            <p id="errorMessage"><%= errorMessage %></p>
        <% } %>
        <% if(posts.length === 0) { %>
            <h1 style="color: red; font-weight: bold;">No Posts</h1>
        <% } else { %> 
            <% posts.forEach(post => { %>
                <div id="post-div">
                    <p id="message-field">
                        <%= post.message %>
                    </p>
                    <p>
                        By:<%= post.user %>
                    </p>
                    <% if(isAdmin) { %>
                        <form method="POST" action="/delete-post" >
                            <input type="hidden" name="postId" value="<%= post._id %>">
                            <button id="Delete-button" type="submit">Delete Post</button>                  
                        </form>
                    <% } %>
                </div>
            <% })%>
        <% } %>
